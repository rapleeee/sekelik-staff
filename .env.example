DISCORD_TOKEN=isi_token_bot_anda_di_sini
DISCORD_CLIENT_ID=id_aplikasi_discord_anda
# Opsional: ID server lama, hanya untuk membersihkan command guild setelah global terverifikasi.
DISCORD_GUILD_ID=
DATABASE_PATH=./data/sekelik-academy.sqlite
# Opsional: Personal Access Token GitHub (read-only Contents) untuk memantau repo private atau menaikkan rate limit.
GITHUB_TOKEN=
# Opsional: interval cek commit GitHub dalam detik (minimal 30, default 120).
GITHUB_POLL_INTERVAL_SECONDS=120
